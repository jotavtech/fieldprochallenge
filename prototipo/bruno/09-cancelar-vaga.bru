meta {
  name: Cancelar vaga
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/vagas/{{vagaId}}/cancelar
  body: json
  auth: none
}

body:json {
  {
    "local_id": "{{localId}}"
  }
}

docs {
  Sai do indice de busca na hora e as ondas pendentes viram "abortada".

  Mesmo caso do passo 8: rodando em ordem vem 409, porque a vaga ja foi confirmada.
}

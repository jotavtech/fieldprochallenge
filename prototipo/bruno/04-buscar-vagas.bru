meta {
  name: Buscar vagas perto de mim
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/vagas/perto-de-mim?latitude=-23.5505&longitude=-46.6333&raio_km=30&especialidade=limpeza&limite=20
  body: none
  auth: none
}

params:query {
  latitude: -23.5505
  longitude: -46.6333
  raio_km: 30
  especialidade: limpeza
  limite: 20
  ~data: 2026-08-20
  ~valor_min: 5000
  ~valor_max: 30000
}

vars:post-response {
  vagaId: res.body[0].id
}

docs {
  Leitura servida pelo indice geoespacial do Redis — nao toca o Postgres.
  Vaga confirmada ou cancelada some daqui na hora. Pegue um id para o {{vagaId}}.
}

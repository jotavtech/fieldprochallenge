# Infra
DATABASE_URL=postgres://fieldpro:fieldpro@localhost:5432/fieldpro
REDIS_URL=redis://localhost:6379
PORT=3000
INICIAR_WORKERS=1

# Regras de negócio (§4 premissas / §7 arquitetura) — todos os knobs de calibração ficam aqui.
URGENTE_HORAS=24              # vaga urgente = publicada com menos de N horas de antecedencia
TOTAL_ONDAS=3                 # RF1
INTERVALO_MINIMO_MS=120000    # premissa #1: piso de 2min entre ondas
LEAD_MS=120000                # margem antes do data_inicio; ondas nao sao agendadas depois disso
CAP_NOTIFICACOES_DIA=3        # RF3 / premissa #2 (contagem global por operador, no fuso do operador)
HISTORICO_MESES=12            # premissa #6: janela da onda 2
RAIO_PADRAO_KM=10             # premissa #7: raio conservador da onda 3
RAIO_EXPANSAO_KM=25           # premissa #7: unico fallback de expansao da onda 3

# Provider de push (RF6)
PUSH_URL=http://localhost:3000/mock-provider/push
PUSH_RPS=600                  # rate limit global compartilhado por todos os workers
PUSH_TENTATIVAS=5             # teto de tentativas antes de marcar notificacao como 'falhou'
PUSH_BACKOFF_MS=500           # base do backoff exponencial (com jitter)

# Mock do provider externo (so existe para fechar o ciclo do RF6 em dev)
MOCK_TAXA_429=0.05
MOCK_TAXA_5XX=0.02
WEBHOOK_URL=http://localhost:3000/webhooks/push
WEBHOOK_SEGREDO=segredo-de-desenvolvimento
